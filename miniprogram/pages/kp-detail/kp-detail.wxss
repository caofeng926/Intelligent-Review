.kp-page {
  height: 100vh;
  background: var(--c-bg, #F8FAFC);
  padding-bottom: 140rpx;
}

.kp-header {
  background: linear-gradient(160deg, #0284C7, #0D9488);
  color: #FFFFFF;
  padding: 32rpx;
}
.kp-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}
.kp-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}
.kp-tag {
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
}
.kp-meta-text { opacity: 0.85; }

.kp-card {
  background: var(--c-surface, #FFFFFF);
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}
.kp-card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text, #0F172A);
  margin-bottom: 16rpx;
}
.kp-card-count {
  font-size: 22rpx;
  color: var(--c-text-muted, #64748B);
  font-weight: 400;
}
.kp-card-body {
  font-size: 28rpx;
  color: var(--c-text, #0F172A);
  line-height: 1.6;
}

.kp-codes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.kp-code {
  display: inline-block;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-family: ui-monospace, "SFMono-Regular", monospace;
  background: var(--c-surface-alt, #F1F5F9);
  color: var(--c-primary, #0284C7);
  border-radius: 8rpx;
}
.kp-empty-list {
  font-size: 26rpx;
  color: var(--c-text-muted, #64748B);
  text-align: center;
  padding: 24rpx 0;
}

.kp-related { }
.kp-related-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
}
.kp-related-item:last-child { border-bottom: none; }
.kp-related-name { font-size: 28rpx; color: var(--c-text, #0F172A); }
.kp-related-sub { font-size: 22rpx; color: var(--c-text-muted, #64748B); margin-top: 4rpx; }

.kp-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--c-surface, #FFFFFF);
  border-top: 1rpx solid var(--c-border, #E2E8F0);
  padding: 16rpx 32rpx env(safe-area-inset-bottom, 16rpx);
}
.kp-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-muted, #64748B);
  gap: 4rpx;
}
.kp-action.rich-text, .kp-action { line-height: 1; }
.kp-action-text { font-size: 22rpx; }
.kp-action-active { color: var(--c-warning, #D97706); font-weight: 600; }

.kp-spacer { height: 120rpx; }

.kp-subscribe-btn {
  display: flex !important;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--c-primary, #0284C7);
  background: var(--c-primary-50, #F0F9FF);
  border: 1rpx solid var(--c-primary-100, #E0F2FE);
  border-radius: 9999rpx;
  align-self: flex-start;
  line-height: 1.4;
}
.kp-subscribe-btn::after { border: none; }
.kp-subscribe-btn rich-text { font-size: 28rpx; }

.empty-wrap { padding: 120rpx 24rpx; }
.safe-bottom-pad { height: 100rpx; }
