.cat-page {
  padding: 32rpx 24rpx 96rpx;
  background: var(--c-bg, #F8FAFC);
  min-height: 100vh;
}

.cat-header { margin-bottom: 24rpx; }
.cat-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-text, #0F172A);
}
.cat-sub {
  font-size: 26rpx;
  color: var(--c-text-muted, #64748B);
  margin-top: 4rpx;
}

.cat-grid { display: flex; flex-direction: column; gap: 16rpx; }

.cat-card {
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
  transition: opacity 0.15s;
}
.cat-card:active { opacity: 0.7; }

.cat-card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.cat-card-rule .cat-card-icon { background: #EEF2FF; color: var(--c-cat-rule); }
.cat-card-yp   .cat-card-icon { background: #ECFDF5; color: var(--c-cat-yp); }
.cat-card-hc   .cat-card-icon { background: #EFF6FF; color: var(--c-cat-hc); }
.cat-card-ivd  .cat-card-icon { background: #F5F3FF; color: var(--c-cat-ivd); }
.cat-card-icd  .cat-card-icon { background: #FEF2F2; color: var(--c-cat-icd); }
.cat-card-tcm  .cat-card-icon { background: #ECFEFF; color: var(--c-cat-tcm); }
.cat-card-ms   .cat-card-icon { background: #FFFBEB; color: var(--c-cat-ms); }

.cat-card-body { flex: 1; min-width: 0; }
.cat-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text, #0F172A);
}
.cat-card-sub {
  font-size: 22rpx;
  color: var(--c-text-muted, #64748B);
  margin-top: 4rpx;
}

.cat-card-count {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-primary, #0284C7);
  min-width: 100rpx;
  text-align: right;
}

.cat-footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--c-text-light, #94A3B8);
}
.safe-bottom-pad { height: 80rpx; }
