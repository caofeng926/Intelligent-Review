.search-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--c-bg, #F8FAFC);
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--c-surface, #FFFFFF);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
  color: var(--c-text-muted, #64748B);
  margin-right: 12rpx;
  display: flex;
  align-items: center;
}
.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  background: var(--c-surface-alt, #F1F5F9);
  border-radius: 9999rpx;
  padding: 0 24rpx;
}
.search-clear {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
  color: var(--c-text-muted, #64748B);
  background: var(--c-surface-alt, #F1F5F9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabs {
  white-space: nowrap;
  background: var(--c-surface, #FFFFFF);
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
  padding: 8rpx 16rpx;
}
.tab {
  display: inline-block;
  padding: 16rpx 24rpx;
  margin: 0 6rpx;
  font-size: 26rpx;
  color: var(--c-text-muted, #64748B);
  border-radius: 8rpx;
  position: relative;
  transition: color 0.2s, background 0.2s;
}
.tab-active {
  color: var(--c-primary, #0284C7);
  background: var(--c-primary-50, #F0F9FF);
  font-weight: 600;
}

.result-summary {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: var(--c-text-muted, #64748B);
  background: var(--c-bg, #F8FAFC);
}
.result-count { color: var(--c-primary, #0284C7); font-weight: 700; }

.history {
  padding: 24rpx;
  background: var(--c-surface, #FFFFFF);
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
}
.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-muted, #64748B);
  margin-bottom: 16rpx;
}
.history-clear {
  color: var(--c-text-light, #94A3B8);
}
.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.history-item {
  display: inline-block;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: var(--c-surface-alt, #F1F5F9);
  color: var(--c-text, #0F172A);
  border-radius: 9999rpx;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot { padding: 24rpx; background: var(--c-surface, #FFFFFF); border-bottom: 1rpx solid var(--c-border, #E2E8F0); }
.hot .history-item {
  background: linear-gradient(135deg, #FEF3C7, #FEE2E2);
  color: #92400E;
}
.text-muted { color: var(--c-text-light, #94A3B8); }

.result-list {
  flex: 1;
  padding: 8rpx 24rpx;
}
.result-items { padding-bottom: 24rpx; }
.list-end {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: var(--c-text-light, #94A3B8);
}
.empty-wrap {
  padding: 80rpx 0;
}
