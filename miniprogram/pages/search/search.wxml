<!-- pages/search/search.wxml -->
<view class="search-page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-icon"><rich-text nodes="{{searchIcon}}" /></view>
    <input class="search-input" placeholder="输入药品 / 规则 / 编码 / 适应症" confirm-type="search" value="{{q}}" bindinput="onInput" bindconfirm="onSubmit" focus="{{true}}" />
    <view class="search-clear" bindtap="onClear" wx:if="{{q}}"><rich-text nodes="{{xIcon}}" /></view>
  </view>

  <!-- tab 切换 -->
  <scroll-view class="tabs" scroll-x enable-flex>
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.key === activeTab ? 'tab-active' : ''}}" data-tab="{{item.key}}" bindtap="switchTab">
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 未输入关键词时显示历史 -->
  <view wx:if="{{!q && history.length}}" class="history">
    <view class="history-head">
      <text>最近搜索</text>
      <text class="history-clear" bindtap="clearHistory">清空</text>
    </view>
    <view class="history-list">
      <view wx:for="{{history}}" wx:key="*this" class="history-item" data-q="{{item}}" bindtap="tapHistory">{{item}}</view>
    </view>
  </view>

  <!-- 未输入关键词 + 无历史 → 显示热门搜索 -->
  <view wx:if="{{!q && !history.length && hotQueries.length}}" class="hot">
    <view class="history-head">
      <text>热门搜索</text>
      <text class="history-clear text-muted">大家都在搜</text>
    </view>
    <view class="history-list">
      <view wx:for="{{hotQueries}}" wx:key="*this" class="history-item hot-item" data-q="{{item}}" bindtap="tapHistory">{{item}}</view>
    </view>
  </view>

  <!-- 结果统计 -->
  <view class="result-summary" wx:if="{{q && !loading}}">
    共找到 <text class="result-count">{{total}}</text> 条结果
  </view>

  <!-- 列表 -->
  <scroll-view class="result-list" scroll-y enable-back-to-top bindscrolltolower="onReachBottom">
    <loading wx:if="{{loading && !items.length}}" tip="正在检索…" />

    <view wx:if="{{!loading && !items.length}}" class="empty-wrap">
      <empty-state icon="search" title="{{q ? '暂无匹配结果' : '请输入关键词'}}" desc="{{q ? '试试更简短的关键词，或切换其他代码表' : ''}}" action-text="{{q ? '清空' : ''}}" bind:action="onClear" />
    </view>

    <view class="result-items">
      <kp-card wx:for="{{items}}" wx:key="id" item="{{item}}" keyword="{{q}}" compact bind:tap="onTapItem" />
    </view>

    <view class="list-end" wx:if="{{items.length && !loading && page >= pages}}">— 已加载全部 —</view>
    <view class="list-end" wx:if="{{items.length && loading && !isCode}}">加载中…</view>
  </scroll-view>
</view>
