.home-page {
  height: 100vh;
  background: var(--c-bg, #F8FAFC);
}

/* Hero */
.hero {
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(160deg, #0284C7 0%, #0D9488 100%);
  color: #FFFFFF;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 32rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.96);
  color: #0F172A;
  border-radius: 9999rpx;
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.search-icon {
  width: 36rpx;
  height: 36rpx;
  color: #64748B;
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

/* Stats */
.stats {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}
.stats-card {
  flex: 1;
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
}
.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--c-primary, #0284C7);
  line-height: 1.2;
}
.stats-num-accent { color: var(--c-accent, #0D9488); }
.stats-label {
  font-size: 22rpx;
  color: var(--c-text-muted, #64748B);
  margin-top: 4rpx;
}

/* Grid */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 16rpx;
}
.grid-item {
  flex: 1 1 calc(50% - 16rpx);
  min-width: calc(50% - 16rpx);
  box-sizing: border-box;
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04);
  position: relative;
  overflow: hidden;
}
.grid-item::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 8rpx; height: 100%;
  background: var(--c-primary, #0284C7);
}
.grid-primary::before { background: var(--c-primary, #0284C7); }
.grid-accent::before  { background: var(--c-accent, #0D9488); }
.grid-hc::before      { background: var(--c-cat-hc, #2563EB); }
.grid-rule::before    { background: var(--c-cat-rule, #4F46E5); }
.grid-disabled { opacity: 0.5; }
.grid-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text, #0F172A);
}
.grid-sub {
  font-size: 22rpx;
  color: var(--c-text-muted, #64748B);
}

/* Section */
.section {
  padding: 32rpx 24rpx 0;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--c-text, #0F172A);
}

.cat-list {
  display: flex;
  flex-direction: column;
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  overflow: hidden;
}
.cat {
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cat:last-child { border-bottom: none; }
.cat-count { font-size: 24rpx; color: var(--c-text-muted, #64748B); font-weight: 400; }

.cat.cat-hc  { color: var(--c-cat-hc, #2563EB); }
.cat.cat-yp  { color: var(--c-cat-yp, #059669); }
.cat.cat-tcm { color: var(--c-cat-tcm, #0891B2); }
.cat.cat-icd { color: var(--c-cat-icd, #DC2626); }
.cat.cat-ivd { color: var(--c-cat-ivd, #7C3AED); }
.cat.cat-ms  { color: var(--c-cat-ms, #D97706); }

/* Recent */
.empty-state-wrap { padding: 0 24rpx; }
.recent-list {
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
}
.recent-item {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
}
.recent-item:last-child { border-bottom: none; }
.recent-subject {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text, #0F172A);
  line-height: 1.4;
}
.recent-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-muted, #64748B);
}
.recent-batch { color: var(--c-primary, #0284C7); }

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--c-text-light, #94A3B8);
  padding: 32rpx 24rpx 16rpx;
}
.safe-bottom-pad {
  height: 120rpx;
}
