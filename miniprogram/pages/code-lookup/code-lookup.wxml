<!-- pages/code-lookup/code-lookup.wxml -->
<view class="cl-page">
  <view class="cl-card">
    <view class="cl-title">医保编码反查</view>
    <view class="cl-sub">输入 19 位医保编码 / 药品本位码 / ICD 编码，立刻查到它所属的审核规则。</view>

    <view class="cl-input-row">
      <view class="cl-icon"><rich-text nodes="{{searchIcon}}" /></view>
      <input class="cl-input" placeholder="如：XK00000123456789" value="{{code}}" bindinput="onInput" bindconfirm="onSubmit" confirm-type="search" />
      <view class="cl-scan" bindtap="onScan">
        <rich-text nodes="{{scanIcon}}" />
      </view>
    </view>

    <button class="cl-btn" bindtap="onSubmit" disabled="{{!code}}">查询</button>
  </view>

  <loading wx:if="{{loading}}" tip="查询中…" />

  <view class="cl-empty" wx:if="{{notFound && !loading}}">
    <empty-state icon="info" title="未查询到匹配规则" desc="可能是医保编码尚未在规则库中收录" />
  </view>

  <block wx:if="{{result && !loading}}">
    <view class="cl-result">
      <!-- kind = rule_code -->
      <block wx:if="{{result.kind === 'rule_code'}}">
        <view class="cl-head">
          <text class="cl-head-tag">编码</text>
          <text class="cl-head-code">{{result.code}}</text>
          <text class="cl-head-count">{{result.count}} 条规则</text>
        </view>
        <view class="cl-item" wx:for="{{result.items}}" wx:key="kp_id" data-id="{{item.kp_id}}" bindtap="onTapItem">
          <view class="cl-item-title">{{item.subject_name}}</view>
          <view class="cl-item-sub" wx:if="{{item.rule_subject}}">{{item.rule_subject}}</view>
          <view class="cl-item-meta">
            <text class="cl-meta-tag" wx:if="{{item.source}}">{{item.source}}</text>
            <text wx:if="{{item.batch_label}}" class="cl-meta-batch">{{item.batch_label}}</text>
          </view>
          <view class="cl-item-drug" wx:if="{{item.drug_detail && item.drug_detail.manufacturer}}">
            <text>厂家：{{item.drug_detail.manufacturer}}</text>
            <text wx:if="{{item.drug_detail.spec}}">· {{item.drug_detail.spec}}</text>
          </view>
        </view>
      </block>
      <!-- kind = consumable / consumable7 -->
      <block wx:if="{{result.kind === 'consumable' || result.kind === 'consumable7'}}">
        <view class="cl-head">
          <text class="cl-head-tag">耗材编码</text>
          <text class="cl-head-code">{{result.data.code}}</text>
        </view>
        <view class="cl-consumable">
          <view class="cl-row"><text class="cl-key">名称</text><text class="cl-val">{{result.data.generic_name || '—'}}</text></view>
          <view class="cl-row" wx:if="{{result.data.cat_l1_name}}"><text class="cl-key">一级分类</text><text class="cl-val">{{result.data.cat_l1_name}}</text></view>
          <view class="cl-row" wx:if="{{result.data.cat_l2_name}}"><text class="cl-key">二级分类</text><text class="cl-val">{{result.data.cat_l2_name}}</text></view>
          <view class="cl-row" wx:if="{{result.data.manufacturer}}"><text class="cl-key">厂家</text><text class="cl-val">{{result.data.manufacturer}}</text></view>
          <view class="cl-row" wx:if="{{result.data.spec}}"><text class="cl-key">规格</text><text class="cl-val">{{result.data.spec}}</text></view>
          <view class="cl-row" wx:if="{{result.data.material}}"><text class="cl-key">材料</text><text class="cl-val">{{result.data.material}}</text></view>
        </view>
      </block>
    </view>
  </block>
</view>
