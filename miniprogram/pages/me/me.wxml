<!-- pages/me/me.wxml -->
<view class="me-page">
  <!-- 用户信息 -->
  <view class="me-header">
    <view class="me-avatar">{{ (openid || '?').slice(0, 1).toUpperCase() }}</view>
    <view class="me-info">
      <view class="me-name">{{ openid ? '医保审核员' : '未登录' }}</view>
      <view class="me-openid" wx:if="{{openid}}">ID: {{ openid.slice(0, 12) }}{{ openid.length > 12 ? '...' : '' }}</view>
      <view class="me-openid" wx:else>首次打开即自动登录</view>
    </view>
  </view>

  <!-- 数字卡片 -->
  <view class="me-stats">
    <view class="me-stat">
      <view class="me-stat-num">{{stats.favs}}</view>
      <view class="me-stat-label">收藏</view>
    </view>
    <view class="me-stat">
      <view class="me-stat-num">{{stats.history}}</view>
      <view class="me-stat-label">搜索词</view>
    </view>
    <view class="me-stat">
      <view class="me-stat-num">{{stats.scans}}</view>
      <view class="me-stat-label">扫码</view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="me-section">
    <view class="me-section-title">
      <text>我的收藏</text>
      <text class="me-section-extra">{{stats.favs}} 条</text>
    </view>

    <loading wx:if="{{loading}}" tip="加载中…" />

    <view wx:if="{{!loading && !favs.length}}" class="me-empty">
      <empty-state icon="star" title="还没有收藏" desc="在知识点详情页点击右上角 ☆ 即可收藏" />
    </view>

    <view class="me-fav-list" wx:if="{{favs.length}}">
      <view wx:for="{{favs}}" wx:key="kp_id" class="me-fav-item">
        <view class="me-fav-body" data-id="{{item.kp_id}}" bindtap="onTapFav">
          <view class="me-fav-name line-clamp-2">{{item.name || '未命名'}}</view>
          <view class="me-fav-meta">
            <text wx:if="{{item.batch_label}}" class="me-fav-batch">{{item.batch_label}}</text>
            <text wx:if="{{item.created_at}}" class="me-fav-time">· {{item.created_at}}</text>
          </view>
        </view>
        <view class="me-fav-remove" data-id="{{item.kp_id}}" catchtap="onUnfav">
          <rich-text nodes='<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' />
        </view>
      </view>
    </view>
  </view>

  <!-- 操作菜单 -->
  <view class="me-section">
    <view class="me-menu">
      <button class="me-menu-item" data-action="clear-cache" bindtap="onTapMenu" hover-class="me-menu-press">
        <view class="me-menu-icon"><rich-text nodes='<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="#0284C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' /></view>
        <text>清理缓存</text>
        <view class="me-menu-arrow">›</view>
      </button>
      <button class="me-menu-item" data-action="privacy" bindtap="onTapMenu" hover-class="me-menu-press">
        <view class="me-menu-icon"><rich-text nodes="{{privacyIcon}}" /></view>
        <text>隐私协议</text>
        <view class="me-menu-arrow">›</view>
      </button>
      <button class="me-menu-item" data-action="about" bindtap="onTapMenu" hover-class="me-menu-press">
        <view class="me-menu-icon"><rich-text nodes='<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="#0284C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>' /></view>
        <text>关于医保智审</text>
        <view class="me-menu-arrow">›</view>
      </button>
      <button class="me-menu-item" open-type="feedback">
        <view class="me-menu-icon"><rich-text nodes="{{feedbackIcon}}" /></view>
        <text>意见反馈</text>
        <view class="me-menu-arrow">›</view>
      </button>
      <button class="me-menu-item" open-type="contact">
        <view class="me-menu-icon"><rich-text nodes="{{contactIcon}}" /></view>
        <text>联系客服</text>
        <view class="me-menu-arrow">›</view>
      </button>
    </view>
  </view>

  <view class="me-footer">© 2026 医保智审规则库 · V1.1</view>
</view>