/**
 * 医保智审 - 全局样式
 * 主题：Clinical Clarity v2
 * - 天蓝 #0284C7（主色，权威/医疗）
 * - 青色 #0D9488（辅色，操作/辅助）
 * - 板岩灰系（中性背景/文字）
 * - 七大分类色板（HC/IVD/YP/ICD/MS/TCM/Rule）
 */

/* ---------------------------- CSS 变量 ---------------------------- */
page {
  /* primary */
  --c-primary: #0284C7;
  --c-primary-dark: #0369A1;
  --c-primary-light: #38BDF8;
  --c-primary-50: #F0F9FF;
  --c-primary-100: #E0F2FE;
  --c-accent: #0D9488;
  --c-accent-dark: #0F766E;
  --c-accent-50: #F0FDFA;

  /* surface */
  --c-bg: #F8FAFC;
  --c-surface: #FFFFFF;
  --c-surface-alt: #F1F5F9;
  --c-border: #E2E8F0;
  --c-border-strong: #CBD5E1;

  /* text */
  --c-text: #0F172A;
  --c-text-strong: #020617;
  --c-text-muted: #64748B;
  --c-text-light: #94A3B8;
  --c-text-on-primary: #FFFFFF;

  /* semantic */
  --c-success: #16A34A;
  --c-warning: #D97706;
  --c-danger: #DC2626;
  --c-info: #2563EB;

  /* category palette - 七大类 */
  --c-cat-hc:    #2563EB; /* HC 医用耗材 - 蓝 */
  --c-cat-ivd:   #7C3AED; /* IVD 诊断试剂 - 紫 */
  --c-cat-yp:    #059669; /* YP 医保药品 - 绿 */
  --c-cat-icd:   #DC2626; /* ICD 国际疾病 - 红 */
  --c-cat-ms:    #D97706; /* MS 医疗服务 - 琥珀 */
  --c-cat-tcm:   #0891B2; /* TCM 中医病证 - 青 */
  --c-cat-rule:  #4F46E5; /* Rule 审核规则 - 靛蓝 */

  /* shadow */
  --c-shadow-sm: 0 1rpx 2rpx rgba(15, 23, 42, 0.06);
  --c-shadow:    0 4rpx 12rpx rgba(15, 23, 42, 0.08);
  --c-shadow-lg: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);

  /* radius */
  --c-radius-sm: 8rpx;
  --c-radius:    16rpx;
  --c-radius-lg: 24rpx;
  --c-radius-xl: 32rpx;
  --c-radius-full: 9999rpx;

  /* spacing */
  --c-pad-1: 4rpx;
  --c-pad-2: 8rpx;
  --c-pad-3: 16rpx;
  --c-pad-4: 24rpx;
  --c-pad-5: 32rpx;
  --c-pad-6: 48rpx;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---------------------------- Reset ---------------------------- */
view, text, button, image, input, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  outline: none;
  font-size: inherit;
  color: inherit;
}
button::after { border: none; }

/* 全局图片允许点击选择 */
image { display: block; }

/* ---------------------------- Utility ---------------------------- */

/* 通用容器 */
.container { padding: var(--c-pad-3); }
.container-pad-4 { padding: var(--c-pad-4); }
.container-pad-5 { padding: var(--c-pad-5); }

/* flex */
.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-col { display: flex; flex-direction: column; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.gap-1 { gap: var(--c-pad-1); }
.gap-2 { gap: var(--c-pad-2); }
.gap-3 { gap: var(--c-pad-3); }
.gap-4 { gap: var(--c-pad-4); }

/* text */
.text-primary { color: var(--c-primary); }
.text-accent { color: var(--c-accent); }
.text-muted { color: var(--c-text-muted); }
.text-light { color: var(--c-text-light); }
.text-success { color: var(--c-success); }
.text-warning { color: var(--c-warning); }
.text-danger { color: var(--c-danger); }

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }
.text-2xl { font-size: 48rpx; }
.text-3xl { font-size: 64rpx; }

.font-bold { font-weight: 600; }
.font-semi { font-weight: 500; }
.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.line-clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* background */
.bg-surface { background: var(--c-surface); }
.bg-bg { background: var(--c-bg); }
.bg-primary { background: var(--c-primary); }

/* 卡片 */
.card {
  background: var(--c-surface);
  border-radius: var(--c-radius);
  padding: var(--c-pad-4);
  box-shadow: var(--c-shadow-sm);
}
.card-press {
  transition: opacity 0.15s;
}
.card-press:active { opacity: 0.7; }

/* 圆角小标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--c-radius-full);
  font-size: 22rpx;
  line-height: 1;
}
.tag-primary { background: var(--c-primary-50); color: var(--c-primary); }
.tag-accent  { background: var(--c-accent-50); color: var(--c-accent); }
.tag-gray    { background: var(--c-surface-alt); color: var(--c-text-muted); }
.tag-success { background: #DCFCE7; color: var(--c-success); }
.tag-warning { background: #FEF3C7; color: var(--c-warning); }
.tag-danger  { background: #FEE2E2; color: var(--c-danger); }

/* 七大分类色标 */
.cat-hc   { color: var(--c-cat-hc); }
.cat-ivd  { color: var(--c-cat-ivd); }
.cat-yp   { color: var(--c-cat-yp); }
.cat-icd  { color: var(--c-cat-icd); }
.cat-ms   { color: var(--c-cat-ms); }
.cat-tcm  { color: var(--c-cat-tcm); }
.cat-rule { color: var(--c-cat-rule); }

.bg-cat-hc   { background: var(--c-cat-hc); }
.bg-cat-ivd  { background: var(--c-cat-ivd); }
.bg-cat-yp   { background: var(--c-cat-yp); }
.bg-cat-icd  { background: var(--c-cat-icd); }
.bg-cat-ms   { background: var(--c-cat-ms); }
.bg-cat-tcm  { background: var(--c-cat-tcm); }
.bg-cat-rule { background: var(--c-cat-rule); }

.fill-cat-hc   { fill: var(--c-cat-hc); }
.fill-cat-ivd  { fill: var(--c-cat-ivd); }
.fill-cat-yp   { fill: var(--c-cat-yp); }
.fill-cat-icd  { fill: var(--c-cat-icd); }
.fill-cat-ms   { fill: var(--c-cat-ms); }
.fill-cat-tcm  { fill: var(--c-cat-tcm); }
.fill-cat-rule { fill: var(--c-cat-rule); }

/* 按下状态 */
.press { transition: opacity 0.15s, transform 0.15s; }
.press:active { opacity: 0.7; transform: scale(0.98); }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--c-border);
  margin: var(--c-pad-3) 0;
}

/* 安全区 */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0); }

/* 触底留白（避开 tabBar） */
.with-tabbar { padding-bottom: 120rpx; }

/* 通用动画 */
.fade-in { animation: fade-in 0.25s ease; }
@keyframes fade-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
