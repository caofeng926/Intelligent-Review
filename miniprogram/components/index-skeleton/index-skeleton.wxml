<!-- 首屏骨架屏：跟首页布局一一对应，避免 CLS -->
<view class="skel">
  <!-- hero 区 -->
  <view class="skel-hero">
    <view class="skel-line skel-h1"></view>
    <view class="skel-line skel-sub"></view>
    <view class="skel-search"></view>
  </view>

  <!-- stats 三卡 -->
  <view class="skel-stats">
    <view class="skel-stat" wx:for="{{[0,1,2]}}" wx:key="*this">
      <view class="skel-block skel-num"></view>
      <view class="skel-line skel-label"></view>
    </view>
  </view>

  <!-- grid 2x2 -->
  <view class="skel-grid">
    <view class="skel-card" wx:for="{{[0,1,2,3]}}" wx:key="*this">
      <view class="skel-line skel-card-name"></view>
      <view class="skel-line skel-card-sub"></view>
    </view>
  </view>

  <!-- 分类列表 -->
  <view class="skel-cat">
    <view class="skel-cat-row" wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this">
      <view class="skel-line skel-cat-name"></view>
    </view>
  </view>
</view>