/* 首页骨架屏 — 与真实页面布局一致，避免 CLS */

.skel {
  padding-bottom: 120rpx;
}

.skel-hero {
  background: linear-gradient(160deg, #0284C7 0%, #0D9488 100%);
  padding: 32rpx 32rpx 48rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
.skel-h1 {
  width: 320rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 8rpx;
}
.skel-sub {
  width: 480rpx;
  height: 28rpx;
  margin-bottom: 32rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 6rpx;
}
.skel-search {
  width: 100%;
  height: 80rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 9999rpx;
}

.skel-stats {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}
.skel-stat {
  flex: 1;
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}
.skel-num {
  width: 80%;
  height: 48rpx;
  margin: 0 auto 8rpx;
}
.skel-label {
  width: 60%;
  height: 24rpx;
  margin: 0 auto;
}

.skel-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 16rpx;
}
.skel-card {
  flex: 1 1 calc(50% - 16rpx);
  min-width: calc(50% - 16rpx);
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}
.skel-card-name {
  width: 70%;
  height: 36rpx;
  margin-bottom: 12rpx;
}
.skel-card-sub {
  width: 50%;
  height: 24rpx;
}

.skel-cat {
  margin: 24rpx;
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  overflow: hidden;
}
.skel-cat-row {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--c-border, #E2E8F0);
}
.skel-cat-row:last-child { border-bottom: none; }
.skel-cat-name { width: 50%; height: 32rpx; }

/* 通用骨架条 */
.skel-line {
  background: linear-gradient(90deg, #F1F5F9 0%, #E2E8F0 50%, #F1F5F9 100%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s linear infinite;
}
.skel-block {
  background: linear-gradient(90deg, #F1F5F9 0%, #E2E8F0 50%, #F1F5F9 100%);
  background-size: 200% 100%;
  border-radius: 12rpx;
  animation: shimmer 1.4s linear infinite;
}
@keyframes shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}