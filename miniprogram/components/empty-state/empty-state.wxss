.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  color: var(--c-text-light, #CBD5E1);
  margin-bottom: 24rpx;
}
.empty-icon .empty-svg-color {
  fill: var(--c-text-light, #CBD5E1);
}

.empty-title {
  font-size: 28rpx;
  color: var(--c-text-muted, #64748B);
  font-weight: 500;
  margin-bottom: 8rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--c-text-light, #94A3B8);
  text-align: center;
  line-height: 1.5;
  max-width: 480rpx;
}

.empty-action {
  margin-top: 32rpx;
  padding: 16rpx 40rpx;
  background: var(--c-primary, #0284C7);
  color: var(--c-text-on-primary, #FFFFFF);
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 500;
}
