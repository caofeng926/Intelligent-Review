.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.loading-spinner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--c-surface-alt, #F1F5F9);
  border-top-color: var(--c-primary, #0284C7);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-tip {
  color: var(--c-text-muted, #64748B);
  font-size: 24rpx;
}

.loading-skeleton {
  width: 100%;
  padding: 24rpx 0;
}
.skel-row {
  height: 120rpx;
  background: linear-gradient(90deg, #F1F5F9 0%, #E2E8F0 50%, #F1F5F9 100%);
  background-size: 200% 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  animation: shimmer 1.4s linear infinite;
}
@keyframes shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}
