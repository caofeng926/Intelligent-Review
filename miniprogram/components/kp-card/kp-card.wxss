.kp-card {
  display: block;
  background: var(--c-surface, #FFFFFF);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(15, 23, 42, 0.04);
  border-left: 6rpx solid transparent;
}

.kp-card.kp-head-cat-hc    { border-left-color: var(--c-cat-hc, #2563EB); }
.kp-card.kp-head-cat-ivd   { border-left-color: var(--c-cat-ivd, #7C3AED); }
.kp-card.kp-head-cat-yp    { border-left-color: var(--c-cat-yp, #059669); }
.kp-card.kp-head-cat-icd   { border-left-color: var(--c-cat-icd, #DC2626); }
.kp-card.kp-head-cat-ms    { border-left-color: var(--c-cat-ms, #D97706); }
.kp-card.kp-head-cat-tcm   { border-left-color: var(--c-cat-tcm, #0891B2); }
.kp-card.kp-head-cat-rule  { border-left-color: var(--c-cat-rule, #4F46E5); }

.kp-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.kp-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.4;
  border-radius: 6rpx;
  background: var(--c-surface-alt, #F1F5F9);
  color: var(--c-text-muted, #64748B);
  font-weight: 500;
}
.kp-tag.cat-hc   { background: #EFF6FF; color: var(--c-cat-hc); }
.kp-tag.cat-ivd  { background: #F5F3FF; color: var(--c-cat-ivd); }
.kp-tag.cat-yp   { background: #ECFDF5; color: var(--c-cat-yp); }
.kp-tag.cat-icd  { background: #FEF2F2; color: var(--c-cat-icd); }
.kp-tag.cat-ms   { background: #FFFBEB; color: var(--c-cat-ms); }
.kp-tag.cat-tcm  { background: #ECFEFF; color: var(--c-cat-tcm); }
.kp-tag.cat-rule { background: #EEF2FF; color: var(--c-cat-rule); }

.kp-title {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 600;
  color: var(--c-text, #0F172A);
}
.kp-title-text { display: inline; }
.kp-title-hl {
  background: #FEF08A;
  color: #92400E;
  border-radius: 4rpx;
  padding: 0 4rpx;
  font-weight: 700;
}

.kp-desc {
  font-size: 26rpx;
  color: var(--c-text-muted, #64748B);
  line-height: 1.5;
  margin-top: 8rpx;
}

.kp-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-light, #94A3B8);
}
.kp-meta-item { font-weight: 400; }
.kp-meta-batch { color: var(--c-primary, #0284C7); }

.kp-mfgs {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.kp-mfg {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: var(--c-surface-alt, #F1F5F9);
  color: var(--c-text-muted, #64748B);
  border-radius: 6rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
