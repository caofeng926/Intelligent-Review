# /etc/medical-audit/env — 由 systemd EnvironmentFile 加载
# 生成 SECRET_KEY: python -c 'import secrets; print(secrets.token_hex(32))'
MA_SECRET_KEY=PLEASE_REPLACE_WITH_SECURE_RANDOM_HEX
# Admin Basic Auth
MA_ADMIN_USER=admin
MA_ADMIN_PASS=PLEASE_REPLACE_WITH_STRONG_PASSWORD
# Admin IP 白名单 (逗号分隔 CIDR)
MA_ADMIN_ALLOW_CIDR=127.0.0.1/32,::1/128
