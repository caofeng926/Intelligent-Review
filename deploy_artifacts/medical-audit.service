[Unit]
Description=Medical Audit Webapp (Flask via gunicorn)
After=network.target
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medical-audit /var/log/medical-audit
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Service]
Type=simple
# Audit 2026-09-03 M6: 不再以 root 运行; 用 medicalaudit 系统用户
User=medicalaudit
Group=medicalaudit
WorkingDirectory=/opt/medical-audit
# Environment: SECRET_KEY 必须显式提供
EnvironmentFile=-/etc/medical-audit/env
ExecStart=/opt/medical-audit/.venv/bin/gunicorn \
  --bind 127.0.0.1:5000 \
  --workers 2 \
  --threads 2 \
  --timeout 60 \
  --access-logfile - \
  --error-logfile - \
  webapp.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
