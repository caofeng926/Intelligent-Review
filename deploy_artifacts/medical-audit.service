[Unit]
Description=Medical Audit Webapp (Flask via gunicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/medical-audit
ExecStart=/opt/medical-audit/.venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 --threads 2 --timeout 60 --access-logfile - --error-logfile - webapp.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
